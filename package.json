{
  "name": "aot-pnasf",
  "version": "1.1.0",
  "description": "Albion Online Tools - Powered Nexus & AI Smart Feed",
  "main": "index.html",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run validate && npm run quality && npm run test:desktop",
    "validate": "node scripts/validate-project.cjs",
    "validate:generated": "node scripts/validate-project.cjs --generated",
    "quality": "node scripts/check-quality.cjs",
    "test:desktop": "node desktop/scripts/test-serve.cjs && node desktop/scripts/test-collect.cjs && node desktop/scripts/test-update.cjs",
    "windows:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File desktop/scripts/build-windows.ps1",
    "windows:collect": "node desktop/scripts/collect-windows.mjs",
    "split-locales": "node scripts/split-locales.cjs",
    "dev": "vite",
    "preview": "vite preview --port 3000 --host 0.0.0.0",
    "update-feed": "node scripts/pvp-fetcher.cjs",
    "maps:fetch": "node scripts/zone-maps-fetcher.cjs",
    "data:gen": "node scripts/gen-game-data.mjs /tmp/ao --indir && node scripts/gen-spells-data.mjs /tmp/ao --indir && node scripts/gen-craft-gear.mjs /tmp/ao",
    "desktop:icons": "python3 desktop/scripts/make-icons.py",
    "desktop:electron": "npm --prefix desktop/electron run start",
    "desktop:electron:win": "npm --prefix desktop/electron run pack:win",
    "desktop:tauri": "npm --prefix desktop/tauri run dev",
    "desktop:tauri:win": "npm --prefix desktop/tauri run build:win",
    "ai-scan": "node scripts/ai-scanner.js",
    "build:debug": "vite build --minify false"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cehennemgibiyim/AoT-PNASF.git"
  },
  "keywords": [
    "albion-online",
    "albion",
    "pvp",
    "market",
    "crafting",
    "tools",
    "gaming"
  ],
  "author": "CehennemGibiyim",
  "license": "MIT",
  "dependencies": {
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
